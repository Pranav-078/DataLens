# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=datasage
POSTGRES_PASSWORD=datasage_local_dev_only
POSTGRES_DB=datasage
POSTGRES_HOST=db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://datasage:datasage@db:5432/datasage?schema=public

# ── Node BFF (backend/node-api) ─────────────────────────────────────────────────
NODE_ENV=development
API_PORT=8000
LOG_LEVEL=info

# absolute path *inside the api container* where uploaded files + duckdb
# version files are written. Mounted as a volume so it survives restarts.
STORAGE_ROOT=/data/storage
MAX_FILE_SIZE_BYTES=52428800      # 50 MB per file
MAX_FILES_PER_UPLOAD=10

# ── Python profiling service (backend/python-engine) ───────────────────────────────
PROFILER_PORT=8001
PROFILER_BASE_URL=http://profiler:8001
PROFILER_TIMEOUT_MS=5000

# ── Gemini AI (server-side only; never expose this key to the browser) ─────
GEMINI_API_KEY=
GEMINI_TIMEOUT_MS=30000

# ── Optional local single-admin cookie authentication ───────────────────────
# Leave AUTH_ENABLED=false for local preview; production requires true.
# Generate AUTH_ADMIN_PASSWORD_HASH as saltHex:scryptHashHex (see docs/authentication.md).
AUTH_ENABLED=false
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD_HASH=
AUTH_COOKIE_SECRET=


# ── Evaluation harness ──────────────────────────────────────────────────────
EVAL_RANDOM_SEED=42

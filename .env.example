# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=datasage
POSTGRES_PASSWORD=datasage_local_dev_only
POSTGRES_DB=datasage
POSTGRES_HOST=db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://datasage:datasage@db:5432/datasage?schema=public

# ── Node BFF (backend/node-api) ─────────────────────────────────────────────────
NODE_ENV=development
API_PORT=8000
LOG_LEVEL=info

# absolute path *inside the api container* where uploaded files + duckdb
# version files are written. Mounted as a volume so it survives restarts.
STORAGE_ROOT=/data/storage
MAX_FILE_SIZE_BYTES=52428800      # 50 MB per file
MAX_FILES_PER_UPLOAD=10

# ── Python profiling service (backend/python-engine) ───────────────────────────────
PROFILER_PORT=8001
PROFILER_BASE_URL=http://profiler:8001
PROFILER_TIMEOUT_MS=5000

# ── Gemini AI (server-side only; never expose this key to the browser) ─────
GEMINI_API_KEY=
GEMINI_TIMEOUT_MS=30000

# ── Retrieval-augmented generation (RAG) ────────────────────────────────────
RAG_RERANK_ENABLED=true
RAG_RETRIEVAL_CANDIDATES=25
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.20
RAG_HISTORY_MESSAGES=8

# ── Account registration and secure cookie authentication ───────────────────
# Enable authentication to use Sign in / Create account.
# Registration can be disabled after onboarding by setting AUTH_ALLOW_REGISTRATION=false.
# The optional admin credentials preserve the original administrator login.
AUTH_ENABLED=false
AUTH_ALLOW_REGISTRATION=true
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD_HASH=
AUTH_COOKIE_SECRET=

# ── Production edge / reverse proxy (leave empty in local development) ────
PUBLIC_ORIGIN=
TRUST_PROXY_HOPS=0


# ── Evaluation harness ──────────────────────────────────────────────────────
EVAL_RANDOM_SEED=42

{
  "name": "datasage-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "5.19.1",
    "csv-parse": "7.0.3",
    "express": "4.22.3",
    "file-type": "21.3.4",
    "iconv-lite": "0.6.3",
    "jschardet": "3.1.4",
    "multer": "2.5.0",
    "pino": "9.4.0",
    "pino-http": "10.3.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.4",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "9.39.5",
    "prisma": "5.19.1",
    "supertest": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.6.2",
    "vitest": "5.1.2"
  }
}

# Copy to .env.production, fill every required value, and keep it out of Git.
# Use URL-encoded database passwords inside both PostgreSQL URLs.

# Public browser origin. TLS must terminate at a trusted HTTPS reverse proxy.
PUBLIC_ORIGIN=https://datalens.example.com
HTTP_PORT=8080
# 1 when only the bundled Nginx proxy is in front of the API.
# Increase to the exact number of trusted proxies if a load balancer/CDN is added.
TRUST_PROXY_HOPS=1

# PostgreSQL administrator/migration credentials.
POSTGRES_DB=datalens
POSTGRES_USER=datalens_migrator
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD
MIGRATION_DATABASE_URL=postgresql://datalens_migrator:URL_ENCODED_ADMIN_PASSWORD@db:5432/datalens?schema=public

# Restricted API runtime account (created/granted by deploy/postgres/grant-runtime.sql).
APP_DB_USER=datalens_app
APP_DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_APP_PASSWORD
APP_DATABASE_URL=postgresql://datalens_app:URL_ENCODED_APP_PASSWORD@db:5432/datalens?schema=public

# Authentication is mandatory in production. Registration is disabled by default.
AUTH_COOKIE_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_BYTES_BASE64URL
AUTH_ALLOW_REGISTRATION=false

# API / profiler
LOG_LEVEL=info
PROFILER_TIMEOUT_MS=240000
MAX_FILE_SIZE_BYTES=52428800
MAX_FILES_PER_UPLOAD=10

# Optional AI workspace. Leave empty to disable provider-backed AI features.
GEMINI_API_KEY=
GEMINI_TIMEOUT_MS=30000
RAG_RERANK_ENABLED=true
RAG_RETRIEVAL_CANDIDATES=25
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.20
RAG_HISTORY_MESSAGES=8

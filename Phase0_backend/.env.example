# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=datasage
POSTGRES_PASSWORD=datasage_local_dev_only
POSTGRES_DB=datasage
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://datasage:datasage_local_dev_only@db:5432/datasage

# ── Node BFF (backend-node) ─────────────────────────────────────────────────
NODE_ENV=development
API_PORT=8000
LOG_LEVEL=info

# absolute path *inside the api container* where uploaded files + duckdb
# version files are written. Mounted as a volume so it survives restarts.
STORAGE_ROOT=/data/storage
MAX_FILE_SIZE_BYTES=52428800      # 50 MB per file
MAX_FILES_PER_UPLOAD=10

# ── Python profiling service (backend-python) ───────────────────────────────
PROFILER_PORT=8001
PROFILER_BASE_URL=http://profiler:8001
PROFILER_TIMEOUT_MS=5000

# ── Evaluation harness ──────────────────────────────────────────────────────
EVAL_RANDOM_SEED=42
